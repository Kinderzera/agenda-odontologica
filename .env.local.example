# Copie este arquivo para ".env.local" e preencha com os valores reais.
# ".env.local" nunca deve ser commitado — já está no .gitignore.

# String de conexão do Postgres. Depois de criar o banco no painel do
# Vercel (Storage > Postgres) e conectar a este projeto, pegue esse valor
# rodando `vercel env pull .env.local` na pasta do projeto (gera o
# arquivo pronto, sem precisar copiar/colar a senha manualmente).
DATABASE_URL=

# Opcional: define a senha do usuário "admin" já na criação do banco.
# Se deixar em branco, o sistema gera uma senha aleatória forte e mostra
# nos logs do servidor na primeira execução.
ADMIN_SENHA_INICIAL=
